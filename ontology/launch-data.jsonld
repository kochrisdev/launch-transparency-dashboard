      ],
      "operatorNote": "Global Fund, US PMI, UNICEF, domestic budgets and procurement agents — tenders, reference pricing, forecasting."
    },
    {
      "@id": "launch:stage-7",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "7",
      "prefLabel": "In-country delivery",
      "stageIndex": 7,
      "operatorNote": "Governments and implementing partners — supply chain, health-worker training, pharmacovigilance."
    },
    {
      "@id": "launch:term-ACT",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "ACT",
      "definition": "Artemisinin-based combination therapy — the standard class of malaria treatments pairing an artemisinin derivative with a longer-acting partner drug."
    },
    {
      "@id": "launch:term-SRA",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "SRA",
      "definition": "Stringent Regulatory Authority — an advanced regulator (e.g. EMA, US FDA) whose review anchors WHO prequalification and country registrations."
    },
    {
      "@id": "launch:term-WLA",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "WLA",
      "definition": "WHO-Listed Authority — a regulator assessed by WHO as operating at an advanced level."
    },
    {
      "@id": "launch:term-Article-58",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "Article 58",
      "definition": "EMA procedure giving a scientific opinion on high-priority medicines intended for markets outside the EU."
    },
    {
      "@id": "launch:term-GDG",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "GDG",
      "definition": "Guidelines Development Group — the WHO expert group that reviews evidence and formulates treatment recommendations."
    },
    {
      "@id": "launch:term-PQ",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "PQ",
      "definition": "WHO prequalification — quality, safety and efficacy assessment that makes a product eligible for procurement by UN agencies and major donors."
    },
    {
      "@id": "launch:term-MFT",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "MFT",
      "definition": "Multiple first-line therapies — deploying several first-line treatments in parallel to reduce drug pressure and slow resistance."
    },
    {
      "@id": "launch:term-EOI",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "EOI",
      "definition": "Expression of Interest — the WHO prequalification invitation list; a product must be on it before a PQ dossier can be assessed."
    },
    {
      "@id": "launch:term-AMA",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "AMA",
      "definition": "African Medicines Agency — continental body coordinating regulatory review across African Union member states."
    },
    {
      "@id": "launch:term-PMI",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "PMI",
      "definition": "U.S. President's Malaria Initiative — a major bilateral funder and procurer of malaria commodities."
    },
    {
      "@id": "launch:term-MMV",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "MMV",
      "definition": "Medicines for Malaria Venture — product development partnership behind several antimalarials."
    },
    {
      "@id": "launch:term-PQR",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "PQR",
      "definition": "Price & Quality Reporting — the Global Fund database of procurement transactions (volumes and prices)."
    },
    {
      "@id": "launch:term-GMP",
