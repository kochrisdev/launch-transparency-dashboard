    {
      "@id": "launch:term-ACT",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "ACT",
      "definition": "Artemisinin-based combination therapy — the standard class of malaria treatments pairing an artemisinin derivative with a longer-acting partner drug."
    },
    {
      "@id": "launch:term-SRA",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "SRA",
      "definition": "Stringent Regulatory Authority — an advanced regulator (e.g. EMA, US FDA) whose review anchors WHO prequalification and country registrations."
    },
    {
      "@id": "launch:term-WLA",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "WLA",
      "definition": "WHO-Listed Authority — a regulator assessed by WHO as operating at an advanced level."
    },
    {
      "@id": "launch:term-Article-58",
      "@type": "Concept",
      "inScheme": "launch:GlossaryScheme",
      "prefLabel": "Article 58",
