      "notation": "0",
      "prefLabel": "R&D & clinical",
      "stageIndex": 0,
      "operatorNote": "Manufacturer and product development partnerships — product-specific; see each product's manufacturedBy / coDevelopedBy."
    },
    {
      "@id": "launch:stage-1",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "1",
      "prefLabel": "Regulatory approval (SRA)",
      "stageIndex": 1,
      "operatedBy": [
        "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-ema",
        "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-fda"
      ],
      "operatorNote": "Stringent regulatory authorities — for malaria medicines usually the EMA via the Article 58 / EU-M4all procedure."
    },
    {
      "@id": "launch:stage-2",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "2",
      "prefLabel": "WHO guidelines",
      "stageIndex": 2,
      "operatedBy": "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-who-gmp",
      "operatorNote": "WHO Global Malaria Programme — its Guidelines Development Group weighs the evidence and decides whether WHO recommends."
    },
    {
      "@id": "launch:stage-3",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "3",
      "prefLabel": "WHO prequalification",
      "stageIndex": 3,
      "operatedBy": "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-who-pq",
      "operatorNote": "WHO Prequalification — quality and manufacturing assessment, separate from the guideline decision."
    },
    {
      "@id": "launch:stage-4",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "4",
      "prefLabel": "Country registration",
      "stageIndex": 4,
      "operatedBy": "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-ama",
      "operatorNote": "National regulatory authorities, country by country — accelerated by the African Medicines Agency and WHO collaborative registration."
    },
    {
      "@id": "launch:stage-5",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "5",
      "prefLabel": "National policy adoption",
      "stageIndex": 5,
      "operatorNote": "Ministries of health and national malaria control programmes — they write the national treatment guidelines."
    },
    {
      "@id": "launch:stage-6",
      "@type": "Concept",
      "inScheme": "launch:PathwayStageScheme",
      "notation": "6",
      "prefLabel": "Procurement",
      "stageIndex": 6,
      "operatedBy": [
        "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-global-fund",
        "https://kochrisdev.github.io/launch-transparency-dashboard/ontology/launch-data.jsonld#org-pmi",
